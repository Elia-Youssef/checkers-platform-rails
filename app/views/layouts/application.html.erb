<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Checkers" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Checkers">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Turbo 8 fetches a link's page when the pointer rests on it, to make the click feel
        instant. Opening an invite link is what takes the free seat in a match, so a fetch
        nobody asked for is a join nobody asked for: prefetching is off for the whole
        application. Nothing here is slow enough to need it. %>
    <meta name="turbo-prefetch" content="false">

    <%= yield :head %>

    <%# The three icons below are the Rails generated favicons under public/. They are the
        only image files in the project and nothing in the game uses an image. %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to the main content</a>

    <header class="masthead">
      <div class="masthead__inner">
        <%= link_to "Checkers", root_path, class: "masthead__brand" %>

        <nav class="masthead__nav" aria-label="Main">
          <%# My games is there for everyone, signed in or not: a guest's matches are listed
              under the key in their browser's cookie, and become the account's the moment
              they sign up or sign in. %>
          <%= link_to "My games", matches_path, class: "masthead__link" %>

          <% if authenticated? %>
            <span class="masthead__identity"><%= Current.user&.display_name %></span>
            <%# A full page load, like signing in and signing up: it ends the document, and the
                Action Cable socket with it, at the moment this browser stops being this user
                (see the note on the sign-in form). %>
            <%= button_to "Sign out", session_path, method: :delete,
                  class: "button button--quiet", form: { data: { turbo: false } } %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "masthead__link" %>
            <%= link_to "Sign up", new_registration_path, class: "masthead__link" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main id="main" class="page">
      <%= render "layouts/flash_zone" %>
      <%= yield %>
    </main>

    <footer class="colophon">
      <p>English draughts. The rules live in a pure-Ruby engine; the pages are Rails.</p>
    </footer>
  </body>
</html>
