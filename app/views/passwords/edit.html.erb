<% content_for :title, "Update your password" %>

<h1>Update your password</h1>

<%# Flashes are rendered by the layout. %>
<%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
  <% if @user&.errors&.any? %>
    <div class="form__errors" role="alert">
      <p><strong><%= pluralize(@user.errors.count, "problem") %> stopped this reset:</strong></p>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form__field">
    <%= form.label :password, "New password" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password",
          minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72 %>
    <span class="form__hint">At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</span>
  </div>

  <div class="form__field">
    <%= form.label :password_confirmation, "Repeat new password" %>
    <%= form.password_field :password_confirmation, required: true,
          autocomplete: "new-password", maxlength: 72 %>
  </div>

  <%= form.submit "Save" %>
<% end %>
