<% content_for :title, "Reset your password" %>

<h1>Forgot your password?</h1>

<p>Give the email address on the account and we will send a link to set a new password.</p>

<%# Flashes are rendered by the layout. %>
<%= form_with url: passwords_path, class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", value: params[:email_address] %>
  </div>

  <%= form.submit "Email reset instructions" %>
<% end %>

<p class="form__aside"><%= link_to "Back to sign in", new_session_path %></p>
