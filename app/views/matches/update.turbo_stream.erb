<%# The answer to an accepted or refused action for a browser with JavaScript on: the same
    four named fragments the match page is built from, replaced in place, plus the flash zone
    so a refusal is visible without a page load. Phase 6 broadcasts these very fragments to
    the other player, which is why their DOM ids are constants on Match. %>
<%= turbo_stream.replace Match::BOARD_ID, partial: "matches/board",
      locals: { match: @match, game: @game, selected: @selected, viewer: @viewer } %>
<%= turbo_stream.replace Match::STATUS_ID, partial: "matches/status",
      locals: { match: @match, game: @game } %>
<%= turbo_stream.replace Match::MOVES_ID, partial: "matches/moves", locals: { game: @game } %>
<%= turbo_stream.replace Match::CONTROLS_ID, partial: "matches/controls",
      locals: { match: @match, game: @game, viewer: @viewer } %>
<%= turbo_stream.replace "flashes", partial: "layouts/flash_zone" %>
