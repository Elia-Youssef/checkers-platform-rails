<%# Who is playing, whose turn it is, how many pieces each side has, and, once the match has
    finished, the result and its reason in words. The counts are taken from the board that is
    actually drawn, so part way through a jump sequence they already show the pieces the
    jumping piece has passed over as taken, exactly as the board does. %>
<%# The announcer controller reads the sentences marked below and copies them into the page's
    one live region, which sits outside every replaced fragment (see matches/show). It writes
    no sentence of its own and decides nothing. %>
<% shown = game.display_position %>
<div id="<%= Match::STATUS_ID %>" class="status" data-controller="announcer">
  <p class="status__headline<%= " status__headline--result" if match.finished? %>" role="status"
     data-announcer-target="sentence">
    <% if match.finished? %>
      <%= result_sentence(match) %>
    <% elsif match.waiting? %>
      Waiting for a second player
    <% elsif game.pending? %>
      <%= turn_sentence(match) %>: finish the jump from square <%= game.locked_square %>
    <% elsif match.cancelled? %>
      This match was cancelled
    <% else %>
      <%= turn_sentence(match) %>
    <% end %>
  </p>

  <%# A pending draw offer is part of the state of the match, not of one seat, so it is said
      here where the opponent, the offerer and any viewer all read the same sentence. The
      Accept and Decline buttons are in the controls fragment, which is per seat. %>
  <% if match.draw_pending? %>
    <p class="status__draw" role="status" data-announcer-target="sentence"><%= draw_offer_sentence(match) %></p>
  <% end %>

  <%# What the computer's search did for its last move, read off the move row rather than
      from a flash, so it is still there after a reload, in a second browser and after a
      container restart. RUBRIC.md item 10 asks for the reached depth to be readable. %>
  <% if (searched = match.last_computer_move) %>
    <p class="status__search" data-announcer-target="sentence"><%= computer_move_sentence(match, searched) %></p>
  <% end %>

  <ul class="players">
    <% Match::SIDES.each do |side| %>
      <li class="player<%= " player--turn" if match.active? && match.side_to_move == side %>">
        <span class="player__swatch player__swatch--<%= side %>" aria-hidden="true"></span>
        <span class="player__side"><%= side_label(side) %></span>
        <span class="player__name"><%= match.seat_name(side) %></span>
        <%# A seat nobody holds has no piece count: the men are on the board, but "Open seat,
            12 pieces" reads as though somebody were playing them (session-6 audit, finding L3;
            the cancelled case came from the diff review's out-of-scope list). A cancelled match
            is not waiting for anybody either, so it says what actually happened. %>
        <% if match.waiting? && !match.seat_taken?(side) %>
          <span class="player__count player__count--empty">waiting to join</span>
        <% elsif match.cancelled? && !match.seat_taken?(side) %>
          <span class="player__count player__count--empty">nobody joined</span>
        <% else %>
          <span class="player__count"><%= pluralize(shown.count(Draughts::Side.cast(side)), "piece") %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
