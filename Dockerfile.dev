# Development image for the Checkers Rails application (English draughts).
# Built and run only through project/compose.yaml, from the project/ directory.
# The production image is the Rails generated Dockerfile and is a separate file.
#
# Base: ruby:4.0.6, which is Debian 13 (trixie). The Ruby 3.4.10 fallback named in
# TASK-BRIEF.md applies only if a required gem turns out to have no Ruby 4.0 build.
FROM ruby:4.0.6

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

# build-essential, pkg-config, zlib1g-dev: compiling native gem extensions.
# sqlite3, libsqlite3-dev: the database in every environment, CLI plus headers.
# libyaml-dev: psych, which Rails loads for every YAML config file.
# git, curl: tooling the Rails generators and bin/ci expect to find.
# chromium, chromium-driver: the headless browser for Capybara system tests, both
# from the Debian archive and from one apt transaction so they cannot drift apart.
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        zlib1g-dev \
        git \
        curl \
        sqlite3 \
        libsqlite3-dev \
        libyaml-dev \
        chromium \
        chromium-driver && \
    rm -rf /var/lib/apt/lists/*

# Fail the image build here, not inside a system test three phases later, if the
# browser and its driver ever come out of the archive at different major versions.
RUN set -eu; \
    browser_major="$(chromium --version | grep -oE '[0-9]+' | head -n 1)"; \
    driver_major="$(chromedriver --version | grep -oE '[0-9]+' | head -n 1)"; \
    echo "chromium major ${browser_major}, chromedriver major ${driver_major}"; \
    if [ "${browser_major}" != "${driver_major}" ]; then \
        echo "chromium and chromedriver major versions differ" >&2; \
        exit 1; \
    fi

# RubyGems pinned to the version whose bundled Bundler is the one Gemfile.lock names, then
# the pinned Rails, so that phase 3 could run `rails new` inside this container. GEM_HOME
# stays at the image default (/usr/local/bundle), which compose.yaml keeps in a named volume.
#
# The pin is not decoration. An unpinned `gem update --system` takes whatever RubyGems is
# newest on the day the image is built, which by round 2 was 4.0.20 with Bundler 4.0.20 as
# its default, while Gemfile.lock says `BUNDLED WITH 4.0.19`. Bundler then switches itself
# mid-boot ("Bundler 4.0.20 is running, but your lockfile was generated with 4.0.19.
# Installing Bundler 4.0.19 and restarting using that version"), fetches that gem from
# rubygems.org, and appends one line to the lock's CHECKSUMS section, so the very first
# command in the README left a reviewer's clone dirty. Measured on a copy of project/ with
# empty volumes: Gemfile.lock md5 7222d4bef38deca0ec27dcda97e2aed7 before `docker compose
# up`, e91f02fbf392231f32b0d1d8cde27375 after, the one added line being
# `bundler (4.0.19) sha256=b48056e4...`. RubyGems 4.0.19 ships Bundler 4.0.19 as its
# default, so pinning the RubyGems version pins both. Change this pin and BUNDLED WITH
# together, never one alone: the check below fails the build if they ever disagree.
ARG RUBYGEMS_VERSION=4.0.19
RUN gem update --system "${RUBYGEMS_VERSION}" --no-document && \
    gem install rails -v 8.1.3.1 --no-document

# Fail the image build here, not on a reviewer's first `docker compose up`, if the Bundler
# this image defaults to is not the one Gemfile.lock was generated with. Gemfile.lock is the
# only application file this image copies, and it is removed again in the same layer: the
# application itself is bind mounted by compose.yaml and nothing of it is baked in.
COPY Gemfile.lock /tmp/Gemfile.lock
RUN set -eu; \
    locked="$(awk '/^BUNDLED WITH$/ { getline; gsub(/[[:space:]]/, "", $0); print; exit }' /tmp/Gemfile.lock)"; \
    default="$(bundle --version | awk '{ print $NF }')"; \
    echo "Gemfile.lock BUNDLED WITH ${locked}, image bundler ${default}"; \
    rm -f /tmp/Gemfile.lock; \
    if [ "${locked}" != "${default}" ]; then \
        echo "the image default Bundler is not the one Gemfile.lock names" >&2; \
        exit 1; \
    fi

WORKDIR /app

EXPOSE 3000

# compose.yaml supplies the real command. A bare `docker run` of this image opens a shell.
CMD ["bash"]
