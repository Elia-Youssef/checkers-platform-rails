# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# The secret the README's alternative production recipe writes here, for people who run the
# production image without the credentials key. It signs cookies, so it belongs beside the
# master key rather than in a commit.
/checkers.secret

# Ignore the Kamal secrets file, which resolves real values at deploy time.
/.kamal/secrets

# Ignore the per-environment credentials keys, as the single master key above is ignored.
/config/credentials/*.key

# Ignore gems installed into the working copy by `bundle install --path`.
/vendor/bundle

# Ignore a node_modules directory, which nothing here needs: there is no Node build step.
/node_modules

# Ignore the Ruby LSP's per-checkout index.
/.ruby-lsp

# Ignore the directory file macOS writes into any folder it looks at.
.DS_Store
