# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Keep deployment credentials and local secret references out of version control.
/.kamal/secrets
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore local dependency and editor artifacts.
/vendor/bundle
/node_modules
/.ruby-lsp
.DS_Store

# Public documentation will be added in a future release.
*.md
*.markdown
*.mdx

# Ignore key files for decrypting credentials and more.
/config/*.key

# The secret the README's alternative production recipe writes here, for people who run the
# production image without the credentials key. It signs cookies, so it belongs beside the
# master key rather than in a commit.
/checkers.secret
